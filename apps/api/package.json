{
  "name": "@iv2/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "seed:user": "node --experimental-strip-types src/scripts/seedDevUser.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^5.2.6",
    "@iv2/db": "workspace:*",
    "@iv2/shared-domain": "workspace:*",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.43.1",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
