{
  "name": "@iv2/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@iv2/db": "workspace:*",
    "@iv2/shared-domain": "workspace:*",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^9.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
